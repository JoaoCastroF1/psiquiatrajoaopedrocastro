{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sobre",
      "destination": "/atuacao",
      "permanent": true
    },
    {
      "source": "/servicos",
      "destination": "/atuacao",
      "permanent": true
    },
    {
      "source": "/contato",
      "destination": "/avaliacao",
      "permanent": true
    },
    {
      "source": "/agendamento",
      "destination": "/avaliacao",
      "permanent": true
    },
    {
      "source": "/artigos",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/artigos/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog/categoria/:slug",
      "destination": "/blog/tema/:slug",
      "permanent": true
    },
    {
      "source": "/blog/tdah-em-adultos",
      "destination": "/blog/tdah-adultos-diferenciar-ansiedade-depressao",
      "permanent": true
    },
    {
      "source": "/blog/tdah-adultos-jovens-estudos",
      "destination": "/blog/tdah-adultos-diferenciar-ansiedade-depressao",
      "permanent": true
    },
    {
      "source": "/blog/remedio-psiquiatrico-vicia",
      "destination": "/blog/psicofarmacos-mitos-verdades",
      "permanent": true
    },
    {
      "source": "/blog/quetiapina-seroquel-bipolar-psicose",
      "destination": "/blog/quetiapina-guia-completo",
      "permanent": true
    },
    {
      "source": "/blog/o-que-e-psicogeriatra-quando-consultar",
      "destination": "/blog/o-que-e-psicogeriatria",
      "permanent": true
    },
    {
      "source": "/blog/lítio-sal-bipolar-gold-standard",
      "destination": "/blog/litio-sal-bipolar-gold-standard",
      "permanent": true
    },
    {
      "source": "/blog/l%C3%ADtio-sal-bipolar-gold-standard",
      "destination": "/blog/litio-sal-bipolar-gold-standard",
      "permanent": true
    },
    {
      "source": "/blog/alprazolam-xanax-panico-anxiety",
      "destination": "/blog/alprazolam-xanax-panico",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://region1.google-analytics.com https://vitals.vercel-insights.com; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
